rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{sellerId}/{fileId} {
      // Anyone can view listing images
      allow read: if true;

      // Only the authenticated @ahduni.edu.in owner (sellerId) can upload
      // or delete files under their own folder
      allow write, delete: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ahduni[.]edu[.]in$')
        && request.auth.uid == sellerId;
    }
  }
}
