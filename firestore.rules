rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listingId} {
      // Anyone can view campus listings
      allow read: if true;

      // Only authenticated @ahduni.edu.in users can create a listing, setting
      // themselves as the seller, and the data must pass validation.
      allow create: if isAuStudent()
        && request.resource.data.sellerId == request.auth.uid
        && isValidListing(request.resource.data);

      // Only the seller (and still an @ahduni.edu.in user) can update or
      // delete their listing; updates must also pass validation.
      allow update: if isAuStudent()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid
        && isValidListing(request.resource.data);

      allow delete: if isAuStudent()
        && resource.data.sellerId == request.auth.uid;
    }

    match /students/{studentId} {
      // Public read so the homepage can show a live "students signed up"
      // count; only the student themself can create/update their own doc,
      // and it can never be deleted from the client.
      allow read: if true;

      allow create, update: if isAuStudent()
        && request.auth.uid == studentId;

      allow delete: if false;
    }

    match /reports/{reportId} {
      // No client can ever read, update, or delete reports — moderation-only
      // data, accessed via the Firebase console / Admin SDK.
      allow read, update, delete: if false;

      // Only authenticated @ahduni.edu.in users can file a report, and only
      // as themselves, with a valid reason and target listing.
      allow create: if isAuStudent()
        && request.resource.data.reporterId == request.auth.uid
        && isValidReport(request.resource.data);
    }

    function isAuStudent() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ahduni[.]edu[.]in$');
    }

    function isValidListing(data) {
      return data.price is number
        && data.price > 0
        && data.price < 500000
        && data.name is string
        && data.name.size() > 0
        && data.name.size() < 200
        && data.description is string
        && data.description.size() < 1000;
    }

    function isValidReport(data) {
      return data.listingId is string
        && data.listingId.size() > 0
        && data.reporterId is string
        && data.reporterId == request.auth.uid
        && data.reason is string
        && data.reason in ['Scam', 'Inappropriate', 'Sold elsewhere', 'Other']
        && data.createdAt == request.time
        && data.keys().hasOnly(['listingId', 'reporterId', 'reason', 'createdAt']);
    }
  }
}
